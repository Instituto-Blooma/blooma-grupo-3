{
  "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}": [
    "oxfmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern",
    "oxlint --tsconfig tsconfig.json --fix --no-error-on-unmatched-pattern"
  ],
  "*.{json,jsonc,md,yml,yaml,css,html}": [
    "oxfmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern"
  ]
}
